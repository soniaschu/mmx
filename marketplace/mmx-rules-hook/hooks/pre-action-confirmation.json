{
  "$schema": "https://schemas.minimax.ai/hooks/1.0/hook-manifest",
  "id": "mmx-pre-action-confirmation",
  "event": "before_tool_call",
  "trigger": {
    "toolNames": ["shell", "file_write", "file_delete", "git_push", "git_force_push", "admin_api_call", "external_request"],
    "riskLevel": ["high", "critical"]
  },
  "mode": "blocking",
  "title": "⚠️ MMX confirmation gate",
  "description": "This action is safety-sensitive; show the MMX rules and require explicit confirmation.",
  "requiredApproval": {
    "confirmationRequired": true,
    "confirmationPhrase": "I confirm",
    "blockOnDeny": true,
    "timeoutSeconds": 300
  },
  "rules": [
    "rules/01-security.md",
    "rules/02-admin-and-permissions.md",
    "rules/03-destructive-operations.md",
    "rules/04-least-privilege.md",
    "rules/05-reality-before-assumption.md",
    "rules/06-proof-before-claim.md",
    "rules/07-no-fake-done.md",
    "rules/08-safety-before-convenience.md"
  ]
}
